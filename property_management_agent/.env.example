# ── Google Gemini API ──────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Property domain to analyse ─────────────────────────────────────────────────
# The company domain whose emails you want to scan (e.g. acme-property.com)
PROPERTY_DOMAIN=your-property-company.com

# ── Database path (optional) ────────────────────────────────────────────────────
# By default the agent writes to property_management_agent/property_data.db.
# Relative paths are resolved against the property_management_agent/ directory
# (NOT the current working directory), so `DB_PATH=property_data.db` and the
# default are equivalent. Use an absolute path to put the DB elsewhere.
# DB_PATH=/absolute/path/to/property_data.db

# ── Google Drive (for drive_agent) ─────────────────────────────────────────────
# drive_agent uses a SERVICE ACCOUNT, not your personal Google login.
# It can only see folders you've explicitly shared with the service account's
# email address — your wider Drive is never accessible.
#
# Setup:
#   1. Create a service account in Google Cloud Console and download its JSON key
#   2. Save the key as property_management_agent/service-account.json  (default
#      location) or set DRIVE_SERVICE_ACCOUNT_JSON to a different absolute path
#   3. Share each Drive folder with the service account's email (Viewer access)
#   4. Set DRIVE_FOLDERS below to a comma-separated list of `label:folder_id`
#      pairs — the label is how the agent refers to the folder ("emails", etc.)
#
# DRIVE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
#
# Example: two folders, labelled "emails" and "attachments"
# DRIVE_FOLDERS=emails:12iOR49m5_ZjDnL8CPPpmDbbR_en9kfk0,attachments:1qtWt5c0k-Ig16JCCJ2UNxKheBEpG96iT
